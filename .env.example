# ==============================================================================
# AI VORA Production Environment Variables for Vercel Deployment
# ==============================================================================

# Destination email for all client inquiries submitted via website forms
CONTACT_DESTINATION_EMAIL=buildtoexcel@gmail.com

# ------------------------------------------------------------------------------
# OPTION 1: Gmail SMTP (Recommended - Zero Cost, Direct to Inbox)
# ------------------------------------------------------------------------------
# 1. Enable 2-Step Verification on buildtoexcel@gmail.com (Google Account Settings)
# 2. Visit: https://myaccount.google.com/apppasswords
# 3. Create a new App Password named "AI VORA Website"
# 4. Copy the generated 16-character code (e.g., "abcd efgh ijkl mnop")
# 5. Add GMAIL_USER and GMAIL_APP_PASSWORD to your Vercel Environment Variables
GMAIL_USER=buildtoexcel@gmail.com
GMAIL_APP_PASSWORD=

# ------------------------------------------------------------------------------
# OPTION 2: Resend API (Alternative Provider)
# ------------------------------------------------------------------------------
# RESEND_API_KEY=re_your_api_key_here
# RESEND_FROM_EMAIL=inquiries@yourdomain.com
